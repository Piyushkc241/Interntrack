# Server
PORT=5000

# PostgreSQL — matches your existing db.js
DB_HOST=localhost
DB_PORT=5432
DB_NAME=interntrack
DB_USER=postgres
DB_PASSWORD=your_password_here

# Auth
JWT_SECRET="replace_this_with_a_long_random_string"
JWT_EXPIRES_IN=7d

# The auth token is set as an httpOnly cookie, so CORS needs the frontend's
# exact origin (not a wildcard) to be allowed to send/receive it.
FRONTEND_URL=http://localhost:5173
# Set to "true" in production (HTTPS): marks the cookie Secure + SameSite=None
# so it survives a cross-site frontend/backend deploy. Keep "false" for local
# http://localhost dev.
COOKIE_SECURE=false

# Cloudinary — resumes are uploaded here instead of local disk.
# Sign up free at https://cloudinary.com, then copy these from your dashboard.
CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Optional — reminder emails. Leave blank and the app works fine, you just
# won't get emails when a reminder comes due. To enable: sign up free at
# https://www.brevo.com, verify a sender email under Settings > Senders
# (no custom domain needed), then create an API key under SMTP & API.
BREVO_API_KEY=your_brevo_api_key_here
# Must be the exact address you verified as a sender in Brevo — sends from
# any other address are rejected.
REMINDER_FROM_EMAIL=baca50001@smtp-brevo.com
REMINDER_FROM_NAME=InternTrack
REMINDER_CHECK_INTERVAL_MINUTES=5

# Optional — how often expired session rows get cleaned up. Defaults to
# once a day, which is plenty; the sessions table grows slowly.
SESSION_CLEANUP_INTERVAL_HOURS=24
